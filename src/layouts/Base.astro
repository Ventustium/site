---
import '../styles/home.css';
import { SITE_URL, UPDATED, person, sameAs, stack } from '../data/site';
import { htmlLang, homePath, locales, ogLocale, t, type Locale } from '../i18n/ui';

interface Props {
    locale: Locale;
    /** Error pages: noindex, no canonical or hreflang alternates, no structured data. */
    noindex?: boolean;
}

const { locale, noindex = false } = Astro.props;
const m = t(locale).meta;
const url = SITE_URL + homePath(locale);
const ogImage = `${SITE_URL}/assets/image/og.jpg`;

// Structured data for search engines and AI answer engines (SEO / AEO / GEO).
const jsonLd = {
    '@context': 'https://schema.org',
    '@graph': [
        {
            '@type': 'Person',
            '@id': `${SITE_URL}/#person`,
            name: person.name,
            alternateName: person.alternateNames,
            url: `${SITE_URL}/`,
            image: `${SITE_URL}/assets/image/icon-512.png`,
            email: `mailto:${person.email}`,
            jobTitle: m.jobTitle,
            description: m.bio,
            knowsAbout: ['System infrastructure', 'DevOps', 'Networking', ...stack],
            homeLocation: { '@type': 'Country', name: 'Indonesia' },
            nationality: { '@type': 'Country', name: 'Indonesia' },
            sameAs,
        },
        {
            '@type': 'WebSite',
            '@id': `${SITE_URL}/#website`,
            url: `${SITE_URL}/`,
            name: 'Ventustium',
            inLanguage: locales.map((l) => htmlLang[l]),
            publisher: { '@id': `${SITE_URL}/#person` },
        },
        {
            '@type': 'ProfilePage',
            '@id': `${url}#profile`,
            url,
            name: `Ventustium · ${person.name}`,
            inLanguage: htmlLang[locale],
            isPartOf: { '@id': `${SITE_URL}/#website` },
            mainEntity: { '@id': `${SITE_URL}/#person` },
            dateModified: UPDATED,
        },
    ],
};
---
<!doctype html>
<html lang={htmlLang[locale]}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="dark">
    <!-- theme-color also sets the accent bar colour of Discord embeds. -->
    <meta name="theme-color" content="#7b4dff">
    <title>{m.title}</title>
    <meta name="description" content={m.description}>
    <meta name="author" content={person.name}>

    {noindex ? (
        <meta name="robots" content="noindex">
    ) : (
        <>
            <meta name="robots" content="index, follow, max-image-preview:large">
            <link rel="canonical" href={url}>
            {locales.map((l) => <link rel="alternate" hreflang={htmlLang[l]} href={SITE_URL + homePath(l)}>)}
            <link rel="alternate" hreflang="x-default" href={`${SITE_URL}/`}>
        </>
    )}

    <!-- Open Graph: Discord, WhatsApp, Telegram, Facebook, LinkedIn. og.jpg is 1200x630 on an opaque background. -->
    <meta property="og:type" content="profile">
    <meta property="og:site_name" content="Ventustium">
    <meta property="og:locale" content={ogLocale[locale]}>
    {locales.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={ogLocale[l]}>)}
    <meta property="og:url" content={url}>
    <meta property="og:title" content={`Ventustium · ${person.name}`}>
    <meta property="og:description" content={m.socialDescription}>
    <meta property="og:image" content={ogImage}>
    <meta property="og:image:secure_url" content={ogImage}>
    <meta property="og:image:type" content="image/jpeg">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content={m.ogImageAlt}>
    <meta property="profile:first_name" content={person.firstName}>
    <meta property="profile:last_name" content={person.lastName}>
    <meta property="profile:username" content={person.username}>

    <!-- summary_large_image makes Discord / X show the big image instead of a small thumbnail. -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={`Ventustium · ${person.name}`}>
    <meta name="twitter:description" content={m.socialDescription}>
    <meta name="twitter:image" content={ogImage}>
    <meta name="twitter:image:alt" content={m.ogImageAlt}>

    <link rel="icon" href="/favicon.ico" sizes="48x48">
    <link rel="icon" type="image/png" sizes="192x192" href="/assets/image/icon-192.png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <link rel="preload" href="/assets/image/600px-logo.webp" as="image" type="image/webp" fetchpriority="high">
    <link rel="preload" href="/assets/fonts/jetbrains-mono-latin-400.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/assets/fonts/jetbrains-mono-latin-700.woff2" as="font" type="font/woff2" crossorigin>

    <!-- Hide inactive scenes before first paint when the scene engine can run. -->
    <script is:inline>if (Element.prototype.animate) document.documentElement.classList.add('js');</script>
</head>
<body>
    <slot />
</body>
</html>
