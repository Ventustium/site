---
import Card from '../Card.astro';
import Heading from '../Heading.astro';
import { codeLinks, stack } from '../../data/site';
import { t, type Locale } from '../../i18n/ui';

interface Props { locale: Locale }
const s = t(Astro.props.locale).code;
---
<section class="scene" id="code" data-title={s.nav} data-out="items">
    <div class="scene-inner split">
        <span class="ghost-word" data-a="ghost" aria-hidden="true">{s.ghost}</span>
        <div class="copy">
            <p class="label" data-a="fade">{s.label}</p>
            <Heading split="words" {...s.title} />
            <p class="desc" data-a="fade">{s.desc}</p>
            <ul class="stack" aria-label={s.stackLabel}>
                {stack.map((tech) => <li data-a="fade">{tech}</li>)}
            </ul>
        </div>
        <ul class="cards">
            {codeLinks.map((link) => <Card link={link} anim="wipe" />)}
        </ul>
    </div>
</section>
