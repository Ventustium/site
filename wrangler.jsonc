{
    "$schema": "node_modules/wrangler/config-schema.json",

    // ---- production: `npm run deploy`, or a push to main (Workers Builds) ----

    // Must match the Worker name in the Cloudflare dashboard.
    "name": "site",
    "compatibility_date": "2026-11-01",
    // Static assets only: no Worker script. `astro build` writes to ./dist.
    "assets": {
        "directory": "./dist",
        "not_found_handling": "404-page"
    },
    // Custom domains attached in the dashboard. Without these, a deploy detaches them.
    "routes": [
        { "pattern": "ventustium.com", "custom_domain": true },
        { "pattern": "www.ventustium.com", "custom_domain": true }
    ],
    "workers_dev": true,
    // Lets `wrangler versions upload` (non-production branches) get a preview URL.
    "preview_urls": true,
    "observability": {
        "enabled": false,
        "logs": {
            "enabled": true,
            "head_sampling_rate": 1,
            "invocation_logs": true,
            "persist": true
        }
    },

    "env": {
        // ---- staging: `npm run deploy:dev`, or a push to a non-production branch ----
        // A separate Worker ("site-dev") on dev-ui.ventustium.com and its workers.dev URL.
        // It never touches ventustium.com or www. Keys are repeated on purpose so this
        // environment never inherits the production routes.
        "dev": {
            "name": "site-dev",
            "assets": {
                "directory": "./dist",
                "not_found_handling": "404-page"
            },
            "routes": [
                { "pattern": "dev-ui.ventustium.com", "custom_domain": true }
            ],
            "workers_dev": true,
            "preview_urls": true
        }
    }
}
